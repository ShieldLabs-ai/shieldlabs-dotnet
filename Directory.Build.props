<Project>
  <!-- Settings shared by every project in this repository. -->
  <PropertyGroup>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Pin the analyzer and compiler warning set so newer SDKs build the same way. -->
    <AnalysisLevel>8.0</AnalysisLevel>
    <!-- net8.0 is a deliberate target; do not turn its end-of-support notice into a build error. -->
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <!-- Audit direct package references; test tooling pulls old transitive packages that never ship. -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>direct</NuGetAuditMode>
    <Authors>ShieldLabs Inc.</Authors>
    <Company>ShieldLabs Inc.</Company>
    <Product>ShieldLabs</Product>
    <Copyright>Copyright (c) 2026 ShieldLabs Inc.</Copyright>
    <RepositoryUrl>https://github.com/ShieldLabs-ai/shieldlabs-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Reproducible package metadata on CI runners. -->
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
